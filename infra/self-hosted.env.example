# Aegis self-hosted configuration.
#
#   cp infra/self-hosted.env.example infra/self-hosted.env
#   docker compose -f infra/docker-compose.self-hosted.yml --env-file infra/self-hosted.env up -d
#
# Every value marked REQUIRED has no default and the stack refuses to start without it.
# That is deliberate: a self-hosted deployment that silently comes up with a development
# secret is worse than one that does not come up at all.

# ---- Secrets (REQUIRED) -------------------------------------------------------------

# Postgres superuser password for the bundled database.
POSTGRES_PASSWORD=

# Redis password. Rate limits and budgets live here, so an unauthenticated Redis means
# anyone on the network can reset a customer's spend counter.
REDIS_PASSWORD=

# Encrypts every stored provider credential (AES-256-GCM). 32 random bytes, base64.
#
#   openssl rand -base64 32
#
# BACK THIS UP SOMEWHERE OTHER THAN THIS MACHINE. Losing it means every BYOK provider key
# in the database becomes permanently unreadable; there is no recovery path, by design.
AEGIS_MASTER_KEY=

# ---- URLs (REQUIRED) ----------------------------------------------------------------

# Where the dashboard is served from. Used for CORS, cookie scope, and canonical URLs.
AEGIS_APP_URL=https://aegis.internal

# Where a BROWSER reaches the gateway. Often the same host on a different path or port.
# This is baked into the dashboard bundle at image build time — changing it later requires
# rebuilding the web image, not just restarting it.
AEGIS_API_PUBLIC_URL=https://aegis.internal/api

# ---- Optional -----------------------------------------------------------------------

# Region label recorded on usage events and enforced for data residency.
AEGIS_REGION=self-hosted

# Enterprise licence key. Without it the gateway runs with community limits rather than
# refusing to start — a licence problem should never be an outage.
AEGIS_LICENSE_KEY=

# Which interface the published ports bind to. Default is loopback only, on the
# assumption that a reverse proxy sits in front. Set to 0.0.0.0 to expose directly.
GATEWAY_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# Postgres database and user, if the defaults clash with an existing convention.
POSTGRES_USER=aegis
POSTGRES_DB=aegis

# Log verbosity. `debug` is safe to enable — the redaction layer strips credentials at
# every level, and there is a startup self-check that proves it.
RUST_LOG=info,aegis_gateway=info

# How long a query the hot cache has proven repeats stays in the durable, encrypted cache
# tier, sliding on every further hit. Pro/Enterprise plans only. See
# docs/adr/0008-tiered-durable-cache.md. Default: 30.
# AEGIS_DURABLE_CACHE_TTL_DAYS=30

# Minimum cosine similarity for a semantic cache hit (a reworded repeat of a prior
# question). Qdrant is already bundled and wired in this compose file — no separate setup
# needed. Default: 0.95, deliberately strict; see cache/semantic.rs's own documentation
# before lowering it.
# AEGIS_SEMANTIC_THRESHOLD=0.95

# Qdrant's gRPC endpoint — lower overhead than the REST API (QDRANT_URL, below), preferred
# when set. See docs/adr/0010-qdrant-grpc-client.md. docker-compose.self-hosted.yml now
# exposes gRPC on 6334 alongside REST on 6333 for the bundled Qdrant service; if you're
# using it, this is simply:
# QDRANT_GRPC_URL=http://qdrant:6334

# Qdrant's REST endpoint. Only consulted when QDRANT_GRPC_URL is unset — kept as a
# fallback that needs no separate port opened, not the primary path once gRPC is available.
# QDRANT_URL=http://qdrant:6333
