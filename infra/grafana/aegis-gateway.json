{
  "__comment": "Aegis gateway dashboard. Import into Grafana and select the Prometheus datasource scraping /metrics. Panel order is deliberate: the top row answers 'are we keeping our promises' (overhead, metering completeness), and only then 'how much traffic is there'. A dashboard that leads with request volume buries the numbers that actually indicate a problem.",
  "title": "Aegis Gateway",
  "uid": "aegis-gateway",
  "tags": ["aegis", "gateway", "production"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway overhead (our own added latency)",
      "description": "Principle 1: P99 under 1ms. This is the number we publish on every response and on the landing page. If the P99 line crosses the threshold, the central performance claim is no longer true.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(aegis_gateway_overhead_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(aegis_gateway_overhead_ms_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Metering completeness",
      "description": "Principle 2: every request produces exactly one usage record. Any value other than zero means requests were served without being metered — somebody is not being billed, and the reconciliation job should already have alerted.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(aegis_requests_total) - sum(aegis_usage_events_total)",
          "legendFormat": "unmetered requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Savings delivered (24h)",
      "description": "Gross savings in micro-cents. Divide by 1,000,000 for dollars.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }
      },
      "targets": [
        {
          "expr": "increase(aegis_savings_micro_cents_total[24h])",
          "legendFormat": "micro-cents saved",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Proportion of requests returning 5xx. Alert threshold is 1%.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aegis_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(aegis_requests_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(aegis_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache outcomes",
      "description": "A collapsing hit rate usually means either a change in traffic shape or a cache that has stopped being populated. Both are worth investigating; the second is a bug.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(aegis_cache_events_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Routing decisions",
      "description": "How requests are being routed. A sudden shift toward passthrough means the classifier or the pricing table changed — savings will fall with it.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(aegis_routing_decisions_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Provider errors and circuit breakers",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(aegis_provider_errors_total[5m])) by (provider)",
          "legendFormat": "{{provider}} errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aegis_circuit_state_changes_total{state=\"open\"}[5m])) by (provider)",
          "legendFormat": "{{provider}} circuit opened",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejections",
      "description": "Rate limit and budget rejections. These are the system working, not failing — but a spike means customers are hitting walls and should be told before they open a ticket.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "sum(rate(aegis_rate_limited_total[5m])) by (scope)",
          "legendFormat": "rate limited ({{scope}})",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aegis_budget_blocked_total[5m])) by (scope)",
          "legendFormat": "budget blocked ({{scope}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "Dominated by the upstream provider. Useful for spotting a slow provider, not for judging our own performance — use the overhead panel for that.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(aegis_request_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(aegis_request_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    }
  ]
}
