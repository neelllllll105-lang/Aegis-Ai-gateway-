# Aegis gateway configuration.
#
#   cp .env.example .env
#
# Every value here has a safe development default, so the gateway runs with none of them
# set. Production is different: Config::validate refuses to start without DATABASE_URL,
# REDIS_URL, AEGIS_MASTER_KEY, and an https base URL.

# --- Environment ----------------------------------------------------------------
# dev | staging | prod
AEGIS_ENV=dev
AEGIS_BIND=0.0.0.0:8080
AEGIS_BASE_URL=http://localhost:8080
AEGIS_APP_URL=http://localhost:3000
AEGIS_REGION=eu-central

# --- Storage ---------------------------------------------------------------------
# Both optional in development. The gateway runs without them, using an in-process
# store and returning an error from endpoints that need persistence.
DATABASE_URL=postgres://aegis:aegis_dev_password@localhost:5432/aegis
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
DATABASE_MAX_CONNECTIONS=20

# --- Secrets ---------------------------------------------------------------------
# 32 bytes, base64. Encrypts every customer BYOK credential.
#
#   openssl rand -base64 32
#
# In development an obviously-fake key is used automatically, so anything encrypted
# locally is worthless — which is the point. Production refuses to start without a real
# one. Rotating it makes every stored credential undecryptable, so treat it accordingly.
# AEGIS_MASTER_KEY=

# Signs self-hosted licences. Only needed if you issue them.
# AEGIS_LICENSE_SIGNING_SECRET=

# --- Shared free-tier keys -------------------------------------------------------
# Keys WE pay for, backing free-tier traffic. Comma-separated; requests are spread
# round-robin so no single key hits its own provider-side rate limit.
# SHARED_OPENAI_KEYS=sk-proj-aaa,sk-proj-bbb
# SHARED_GOOGLE_KEYS=AIza-aaa,AIza-bbb

# --- Email -----------------------------------------------------------------------
# Without a key, transactional email is logged instead of sent.
# RESEND_API_KEY=
AEGIS_EMAIL_FROM=Aegis <noreply@aegis.dev>

# --- Payments --------------------------------------------------------------------
# Webhook verification fails closed without the signing secret: an unconfigured secret
# never means "accept everything".
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Tuning ----------------------------------------------------------------------
AEGIS_MAX_BODY_BYTES=10485760
AEGIS_PROVIDER_TIMEOUT_SECS=30
AEGIS_PROVIDER_TIMEOUT_REASONING_SECS=120
AEGIS_DEFAULT_RATE_LIMIT=60
AEGIS_CACHE_TTL_SECS=86400
AEGIS_SEMANTIC_THRESHOLD=0.95
AEGIS_FREE_TIER_MONTHLY_REQUESTS=10000

# --- Logging ---------------------------------------------------------------------
AEGIS_LOG=info,aegis_gateway=debug

# --- Tests -----------------------------------------------------------------------
# Set to run the DB-backed integration suite. Without it those tests skip themselves,
# so `cargo test` is green on a fresh clone.
# AEGIS_TEST_DATABASE_URL=postgres://aegis:aegis_dev_password@localhost:5432/aegis
